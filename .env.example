# Copy to .env and adjust if needed. .env is gitignored — never commit real credentials.

POSTGRES_USER=h2grid
POSTGRES_PASSWORD=h2grid_dev_password
POSTGRES_DB=h2grid
POSTGRES_PORT=5432

# Consumed by the API, migration runner, and IEA import.
DATABASE_URL=postgres://h2grid:h2grid_dev_password@localhost:5432/h2grid

# Free key from https://finnhub.io/register — powers the Markets panel's live
# per-ticker quotes via the server-side proxy at /api/quotes. Kept here rather
# than in client JS so it is never readable from page source.
FINNHUB_KEY=
